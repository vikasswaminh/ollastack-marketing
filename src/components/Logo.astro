---
// Ollastack brand logo: 3D Stack Emblem + Wordmark + AI Agents
interface Props {
  size?: number;
  variant?: "light" | "dark";
  withWordmark?: boolean;
}
const { size = 46, variant = "light" } = Astro.props;
const logoSrc = variant === "dark" ? "/logo-white.svg" : "/logo.svg";
---

<a href="/" aria-label="Ollastack — Built for AI Agents" class="logo-lockup">
  <img
    src={logoSrc}
    alt="Ollastack — Built for AI Agents"
    class="brand-logo-img"
    style={`height: ${size}px; max-height: 52px; width: auto;`}
  />
</a>

<style>
  .logo-lockup {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .brand-logo-img {
    display: block;
    height: 46px;
    max-height: 52px;
    width: auto;
    transition: transform 0.2s ease;
  }
  .brand-logo-img:hover {
    transform: scale(1.02);
  }
</style>
