---
import Base from "./Base.astro";
import { getCollection } from "astro:content";
import { posts, type PostMeta } from "../data/posts";

interface Props {
  slug: string;
  title: string;
  description: string;
  publishedAt: string;
  updatedAt: string;
  readingTime: string;
  ctaLocation: string;
  faq?: { q: string; a: string }[];
}

const APP = "https://login.ollastack.com";
const SITE = "https://ollastack.com";
const { slug, title, description, publishedAt, updatedAt, readingTime, ctaLocation, faq } = Astro.props;

const fmtNiceDate = (iso: string) => {
  try {
    return new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  } catch (e) {
    return iso;
  }
};

function getCategoryMeta(s: string, t: string) {
  const str = (s + " " + t).toLowerCase();
  if (str.includes("ai-agent") || str.includes("agent")) {
    return { name: "AI Agents", icon: "🤖", pillClass: "tag-agent" };
  }
  if (str.includes("disposable") || str.includes("email") || str.includes("otp") || str.includes("test")) {
    return { name: "Email Testing", icon: "✉️", pillClass: "tag-testing" };
  }
  if (str.includes("vs-") || str.includes("alternative")) {
    return { name: "Comparisons", icon: "⚖️", pillClass: "tag-compare" };
  }
  return { name: "Forms", icon: "⚡", pillClass: "tag-forms" };
}

const catMeta = getCategoryMeta(slug, title);

// Essential Guides for Left Sidebar
const essentialGuides = [
  { title: "What Is a Headless Form? A Simple Guide to Modern Developers", slug: "what-is-a-headless-form-a-simple-guide-to-modern-developers" },
  { title: "Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing in 2026", slug: "mailosaur-vs-mailinator-vs-disposable-inboxes" },
  { title: "Self-Host vs Hosted Form Backend: Complete 2026 Decision Framework", slug: "self-host-vs-hosted-form-backend" },
  { title: "How to Connect a Contact Form to Email Without Backend Code (2026 Guide)", slug: "how-to-connect-a-contact-form-to-email-without-backend-code" },
  { title: "How to Automate OTP Email Testing in CI/CD Pipelines", slug: "how-to-automate-otp-email-testing-in-ci-cd-pipelines" },
  { title: "How Developers Can Use Disposable Inboxes to Speed Up Testing", slug: "how-developers-can-use-disposable-inboxes-to-speed-up-testing" },
  { title: "Disposable Inbox vs Temporary Email: Which One Is Better for Testing?", slug: "disposable-inbox-vs-temporary-email" },
  { title: "Welcome to the OllaStack blog", slug: "welcome-to-the-blog" },
  { title: "Getting started with OllaStack", slug: "getting-started" },
  { title: "How to Build a Form Backend for a Static Site Without Writing a Server", slug: "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" },
  { title: "Form design for higher conversions (and less spam)", slug: "form-design-conversion" },
  { title: "Test email in Docker and CI with a disposable inbox", slug: "test-inbox-docker" },
  { title: "Assert on email in Playwright and Cypress", slug: "assert-on-email-in-playwright-cypress" },
  { title: "Email testing API: assert on real emails in CI", slug: "email-testing-api-for-ci" },
  { title: "Per-tenant SMTP: send from each customer's own server", slug: "per-tenant-smtp-guide" },
];

// Agent Workflows for Right Sidebar
const agentWorkflows = [
  { title: "How to Build AI-Ready Forms for Autonomous Agents", slug: "how-to-build-ai-ready-forms-for-autonomous-agents" },
  { title: "Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing in 2026", slug: "mailosaur-vs-mailinator-vs-disposable-inboxes" },
  { title: "How to Connect a Contact Form to Email Without Backend Code (2026 Guide)", slug: "how-to-connect-a-contact-form-to-email-without-backend-code" },
  { title: "What Is an Agent Email API and Why Does It Matter for AI Workflows?", slug: "what-is-an-agent-email-api" },
  { title: "Form Backend vs Form Builder: What Developers Should Choose in 2026", slug: "form-backend-vs-form-builder" },
  { title: "How to Automate OTP Email Testing in CI/CD Pipelines", slug: "how-to-automate-otp-email-testing-in-ci-cd-pipelines" },
  { title: "How Developers Can Use Disposable Inboxes to Speed Up Testing", slug: "how-developers-can-use-disposable-inboxes-to-speed-up-testing" },
  { title: "Test email in Docker and CI with a disposable inbox", slug: "test-inbox-docker" },
  { title: "Can AI Agents Submit Forms Safely? Here's What Developers Need to Know", slug: "can-ai-agents-submit-forms-safely" },
  { title: "Assert on email in Playwright and Cypress", slug: "assert-on-email-in-playwright-cypress" },
  { title: "Email testing API: assert on real emails in CI", slug: "email-testing-api-for-ci" },
  { title: "How to read an OTP / verification code in an AI agent", slug: "read-otp-verification-code-in-ai-agent" },
  { title: "Build an AI agent that sends and receives email (with MCP)", slug: "build-ai-agent-that-sends-and-receives-email" },
  { title: "Email for AI agents: give an agent its own inbox", slug: "email-for-ai-agents" },
  { title: "ML spam quarantine, and why a form backend should fail open", slug: "ml-quarantine-explained" },
  { title: "AgentMail alternative: agent email + forms + testing", slug: "agentmail-alternative" },
];

import { blogBreadcrumbLd } from "../lib/schema";

// Related posts
const collectionPosts: PostMeta[] = (
  await getCollection("blog", ({ data }) => data.draft !== true)
).map((p) => ({
  slug: p.slug,
  title: p.data.title,
  description: p.data.description,
  date: p.data.date.toISOString().slice(0, 10),
  readingTime: `${p.data.readingTime} min read`,
}));
const STOP = new Set(["the","a","an","to","for","and","in","of","with","your","from","how","2026","without","vs","form","forms","email","api"]);
const toks = (s: string) => new Set(s.split("-").filter((t) => t.length > 2 && !STOP.has(t)));
const cur = toks(slug);

const related: PostMeta[] = [...posts, ...collectionPosts]
  .filter((p) => p.slug !== slug)
  .map((p) => ({ p, score: [...toks(p.slug)].filter((t) => cur.has(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.date.localeCompare(a.p.date))
  .slice(0, 4)
  .map((x) => x.p);

const breadcrumbLd = blogBreadcrumbLd(title, slug);

// Article structured data
const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: publishedAt,
  dateModified: updatedAt || publishedAt,
  author: {
    "@type": "Organization",
    name: "Ollastack",
    url: SITE,
    logo: `${SITE}/logo.svg`,
  },
  publisher: {
    "@type": "Organization",
    name: "Ollastack",
    logo: { "@type": "ImageObject", url: `${SITE}/logo.svg` },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": `${SITE}/blog/${slug}/` },
  url: `${SITE}/blog/${slug}/`,
  image: `${SITE}/og.png`,
  articleSection: catMeta.name,
};

// FAQPage structured data
const faqLd =
  faq && faq.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((f) => ({
          "@type": "Question",
          name: f.q,
          acceptedAnswer: { "@type": "Answer", text: f.a },
        })),
      }
    : null;
---

<Base
  title={title}
  description={description}
  current="blog"
  ogType="article"
  canonicalUrl={`${SITE}/blog/${slug}/`}
  articleMeta={{
    publishedTime: publishedAt,
    modifiedTime: updatedAt || publishedAt,
    author: "Ollastack",
    section: catMeta.name,
  }}
  breadcrumbsLd={breadcrumbLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} is:inline />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />}

  <!-- MAIN 3-COLUMN MAGAZINE SECTION (EXACT REFERENCE DESIGN) -->
  <main class="blog-main-wrapper">
    <div class="magazine-grid">
      
      <!-- ================= LEFT COLUMN: ESSENTIAL GUIDES ================= -->
      <aside class="col-sidebar sidebar-left" aria-label="Essential Guides">
        <div class="sidebar-badge-wrap">
          <div class="pill-badge pill-orange">
            <span>⚡ ESSENTIAL GUIDES</span>
          </div>
        </div>

        <ul class="sidebar-link-list">
          {essentialGuides.map((guide) => (
            <li class="sidebar-link-item">
              <a href={`/blog/${guide.slug}`} class={`side-link ${guide.slug === slug ? 'active-guide-orange' : ''}`}>
                {guide.title}
              </a>
            </li>
          ))}
        </ul>

        <div class="sidebar-footer-link">
          <a href="/blog" class="view-all-link">View All →</a>
        </div>
      </aside>

      <!-- ================= CENTER COLUMN: MAIN ARTICLE ================= -->
      <article class="col-center-article">
        
        <!-- Header -->
        <header class="post-header-box">
          <h1 class="post-display-title">{title}</h1>
          <p class="post-sub-desc">{description}</p>

          <!-- Meta Pill Tags Row -->
          <div class="meta-pills-row">
            <span class={`meta-pill ${catMeta.pillClass}`}>
              <span class="meta-icon">{catMeta.icon}</span>
              <span>{catMeta.name}</span>
            </span>

            <span class="meta-pill meta-neutral">
              <span class="meta-icon">⏱</span>
              <span>{readingTime}</span>
            </span>

            <span class="meta-pill meta-neutral">
              <span class="meta-icon">📅</span>
              <span>Updated {fmtNiceDate(updatedAt || publishedAt)}</span>
            </span>

            <button type="button" class="copy-link-pill-btn" id="copy-link-btn" aria-label="Copy link to article">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
              <span id="copy-btn-label">Copy link</span>
            </button>
          </div>

          <!-- About the Ollastack Engineering Team (Author Trust Card) -->
          <div class="author-trust-card">
            <div class="trust-card-top">
              <div class="author-avatar-circle" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div class="author-info-box">
                <div class="author-name-row">
                  <span class="author-name">About the Ollastack Engineering Team</span>
                  <span class="verified-badge">✓ Verified</span>
                </div>
                <p class="author-bio">
                  Our content is written by industry practitioners with hands-on experience in enterprise cloud & agentic workflows. We don't write theory — we share what actually works in production.
                </p>
              </div>
            </div>

            <div class="trust-badges-row">
              <span class="trust-badge badge-green">🧪 Production Labs</span>
              <span class="trust-badge badge-blue">🛡️ SOC2 Type II Certified</span>
              <span class="trust-badge badge-purple">📖 Developer Playbooks</span>
              <span class="trust-badge badge-amber">👥 10M+ Form Submissions</span>
            </div>
          </div>
        </header>

        <!-- Body Content -->
        <div class="body-content-area body">
          <slot />
        </div>

        {faq && faq.length > 0 && (
          <section class="post-faq" id="faq-section">
            <div class="faq-head-wrap">
              <span class="faq-pill-badge">❓ FREQUENTLY ASKED QUESTIONS</span>
              <h2>Frequently Asked Questions</h2>
            </div>
            <div class="faq-accordion-list">
              {faq.map((item, idx) => (
                <details class="faq-card" open={idx === 0}>
                  <summary class="faq-summary">
                    <span>{item.q}</span>
                    <svg class="faq-icon-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </summary>
                  <div class="faq-body-content">
                    <p>{item.a}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        {related.length > 0 && (
          <nav class="related-foot" aria-label="Related posts">
            <div class="related-eyebrow mono">Related reading</div>
            <ul>
              {related.map((p) => (
                <li>
                  <a href={`/blog/${p.slug}/`}>
                    <span class="rel-title">{p.title}</span>
                    <span class="rel-meta mono">{p.readingTime}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </article>

      <!-- ================= RIGHT COLUMN: AGENT WORKFLOWS ================= -->
      <aside class="col-sidebar sidebar-right" aria-label="Agent Workflows">
        <div class="sidebar-badge-wrap">
          <div class="pill-badge pill-purple">
            <span>🤖 AGENT WORKFLOWS</span>
          </div>
        </div>

        <ul class="sidebar-link-list">
          {agentWorkflows.map((guide) => (
            <li class="sidebar-link-item">
              <a href={`/blog/${guide.slug}`} class={`side-link ${guide.slug === slug ? 'active-guide-purple' : ''}`}>
                {guide.title}
              </a>
            </li>
          ))}
        </ul>

        <div class="sidebar-footer-link">
          <a href="/blog" class="view-all-link view-all-purple">View All →</a>
        </div>
      </aside>

    </div>
  </main>

  <!-- FLOATING RED CTA BUTTON (EXACT REFERENCE DESIGN) -->
  <a href="https://login.ollastack.com/register" target="_blank" class="floating-cta-btn" id="floating-cta-button">
    <span class="cta-sparkle">✦</span>
    <span>Start Building Free</span>
  </a>
</Base>

<script is:inline>
  // Copy link to clipboard
  (function () {
    const btn = document.getElementById("copy-link-btn");
    const label = document.getElementById("copy-btn-label");
    if (!btn || !label) return;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        label.textContent = "Copied!";
        btn.classList.add("copied");
        setTimeout(() => {
          label.textContent = "Copy link";
          btn.classList.remove("copied");
        }, 2000);
      } catch (err) {
        label.textContent = "Copied!";
      }
    });
  })();
</script>

<style>
  /* ==========================================================================
     EXACT 3-COLUMN MAGAZINE LAYOUT MATCHING REFERENCE IMAGE
     ========================================================================== */

  .blog-main-wrapper {
    max-width: 100%;
    margin: 0;
    padding: 28px 20px 96px;
    width: 100%;
    background: #ffffff;
    box-sizing: border-box;
  }

  .magazine-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 280px;
    gap: 28px;
    align-items: start;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
  }

  /* Sidebars (Left & Right) */
  .col-sidebar {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    position: sticky;
    top: 90px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .col-sidebar::-webkit-scrollbar {
    width: 4px;
  }
  .col-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .col-sidebar::-webkit-scrollbar-thumb {
    background: #e2e8f0;
    border-radius: 4px;
  }
  .col-sidebar:hover::-webkit-scrollbar-thumb {
    background: #cbd5e1;
  }

  .sidebar-badge-wrap {
    margin-bottom: 20px;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 9999px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    user-select: none;
  }

  .pill-orange {
    background: linear-gradient(135deg, #ea580c 0%, #f97316 100%);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(234, 88, 12, 0.25);
  }

  .pill-purple {
    background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(124, 58, 237, 0.25);
  }

  .sidebar-link-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-link-item {
    margin: 0;
    padding: 0;
  }

  .side-link {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: #334155;
    display: block;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .side-link:hover {
    color: #ea580c;
    transform: translateX(2px);
  }

  .sidebar-right .side-link:hover {
    color: #7c3aed;
  }

  .active-guide-orange {
    color: #ea580c !important;
    font-weight: 800 !important;
  }

  .active-guide-purple {
    color: #7c3aed !important;
    font-weight: 800 !important;
  }

  .sidebar-footer-link {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px dashed #e2e8f0;
  }

  .view-all-link {
    font-size: 12.5px;
    font-weight: 700;
    color: #ea580c;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    transition: gap 0.15s ease;
  }
  .view-all-link:hover {
    gap: 7px;
  }

  .view-all-purple {
    color: #7c3aed;
  }

  /* ---------- Center Article Column ---------- */
  .col-center-article {
    min-width: 0;
    width: 100%;
  }

  .post-header-box {
    margin-bottom: 28px;
  }

  .post-display-title {
    font-size: 40px;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: #0f172a;
    margin: 0 0 16px;
    word-break: break-word;
  }

  .post-sub-desc {
    font-size: 18px;
    line-height: 1.6;
    color: #475569;
    margin: 0 0 22px;
    font-weight: 400;
  }

  /* Meta Pills Row */
  .meta-pills-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 9999px;
  }

  .tag-agent {
    background: #fdf2f8;
    color: #db2777;
    border: 1px solid #fbcfe8;
  }

  .tag-testing {
    background: #fef2f2;
    color: #dc2626;
    border: 1px solid #fecaca;
  }

  .tag-forms {
    background: #fff7ed;
    color: #c2410c;
    border: 1px solid #ffedd5;
  }

  .tag-compare {
    background: #f5f3ff;
    color: #7c3aed;
    border: 1px solid #ede9fe;
  }

  .meta-neutral {
    background: #f8fafc;
    color: #475569;
    border: 1px solid #e2e8f0;
  }

  .copy-link-pill-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    padding: 6px 16px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .copy-link-pill-btn:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #0f172a;
  }

  .copy-link-pill-btn.copied {
    background: #f0fdf4;
    border-color: #86efac;
    color: #166534;
  }

  /* Author Trust Card (Matching Reference Design) */
  .author-trust-card {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 22px 24px;
    margin-bottom: 32px;
  }

  .trust-card-top {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 16px;
  }

  .author-avatar-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
    flex-shrink: 0;
  }

  .author-info-box {
    flex: 1;
  }

  .author-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
  }

  .author-name {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
  }

  .verified-badge {
    background: #dcfce7;
    color: #15803d;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
  }

  .author-bio {
    font-size: 13.5px;
    line-height: 1.55;
    color: #64748b;
    margin: 0;
  }

  .trust-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px dashed #e2e8f0;
  }

  .trust-badge {
    font-size: 11.5px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .badge-green {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .badge-blue {
    background: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
  }

  .badge-purple {
    background: #faf5ff;
    color: #6b21a8;
    border: 1px solid #e9d5ff;
  }

  .badge-amber {
    background: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  /* Body Content */
  .body-content-area {
    min-width: 0;
    width: 100%;
