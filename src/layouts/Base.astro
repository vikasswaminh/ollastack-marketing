---
import "../styles/global.css";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { docsBreadcrumbLd, techArticleLd, organizationLd, webSiteLd } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  ogType?: "website" | "article";
  canonicalUrl?: string;
  articleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
  };
  breadcrumbsLd?: Record<string, any>;
  noIndex?: boolean;
  // When both are set (docs pages), Base emits BreadcrumbList + TechArticle.
  docsName?: string;
  docsSlug?: string;
}
const {
  title = "Ollastack — AI agent forms, mailboxes & email testing",
  description = "One platform for AI agents: forms they can submit, agent mailboxes that send and receive email, and disposable inboxes for email testing in CI.",
  current,
  ogType = "website",
  canonicalUrl,
  articleMeta,
  breadcrumbsLd,
  noIndex = false,
  docsName,
  docsSlug,
} = Astro.props;

const origin = (Astro.site ?? new URL("https://ollastack.com")).origin;
const cleanPath = Astro.url.pathname.replace(/\/$/, "");
const canonical = canonicalUrl ?? (cleanPath === "" ? `${origin}/` : `${origin}${cleanPath}/`);
// Social scrapers require an absolute image URL.
const ogImage = `${origin}/og.png`;
const isHomePage = cleanPath === "";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
  <link rel="canonical" href={canonical} />
  <meta name="description" content={description} />
  <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Ollastack — AI agent forms, mailboxes and email testing" />
  {ogType === "article" && articleMeta && (
    <>
      {articleMeta.publishedTime && <meta property="article:published_time" content={articleMeta.publishedTime} />}
      {articleMeta.modifiedTime && <meta property="article:modified_time" content={articleMeta.modifiedTime} />}
      <meta property="article:author" content={articleMeta.author || "Ollastack"} />
      {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
    </>
  )}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#fafaf7" />
  <title>{title}</title>
  {isHomePage && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} is:inline />
      <script type="application/ld+json" set:html={JSON.stringify(webSiteLd)} is:inline />
    </>
  )}
  {breadcrumbsLd && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} is:inline />
  )}
  {docsName && docsSlug && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(docsBreadcrumbLd(docsName, docsSlug))} is:inline />
      <script type="application/ld+json" set:html={JSON.stringify(techArticleLd({ title: docsName, description, slug: docsSlug }))} is:inline />
    </>
  )}
</head>
<body>
  <AnnouncementBar />
  <Nav current={current} />
  <main><slot /></main>
  <Footer />

  <!-- Progressive enhancement: give every hand-written docs code block a
       copy-to-clipboard button. (The Scalar API-ref page has its own.) -->
  <script is:inline>
    (function () {
      var blocks = document.querySelectorAll("pre.code");
      blocks.forEach(function (pre) {
        if (pre.querySelector(".code-copy")) return;
        // Capture the code BEFORE injecting the button; strip shell prompts.
        var code = pre.textContent.replace(/^\s*\$\s+/gm, "");
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "code-copy";
        btn.textContent = "Copy";
        btn.setAttribute("aria-label", "Copy code");
        btn.addEventListener("click", function () {
          navigator.clipboard.writeText(code).then(function () {
            btn.textContent = "Copied";
            setTimeout(function () { btn.textContent = "Copy"; }, 1500);
          }).catch(function () {});
        });
        pre.appendChild(btn);
      });
    })();
  </script>
</body>
</html>

<style is:global>
  /* Responsive docs tables — scroll inside their own box on small screens
     instead of pushing the page body wide (fixes ~300px horizontal overflow
     on /docs and other docs pages with wide API tables). */
  @media (max-width: 640px) {
    .content table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      max-width: 100%;
    }
  }

  /* Copy button injected on hand-written docs code blocks. */
  pre.code { position: relative; }
  .code-copy {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 11px;
    line-height: 1;
    padding: 4px 8px;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 5px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.12s ease;
  }
  pre.code:hover .code-copy,
  .code-copy:focus { opacity: 1; }
  /* Touch devices have no hover — keep the button visible there. */
  @media (hover: none) {
    .code-copy { opacity: 0.7; }
  }
</style>
