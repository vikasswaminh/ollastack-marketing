---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { posts as legacyPosts } from "../../data/posts";

const fmtDate = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

function getPostCategory(slug: string, title = ""): { category: string; categorySlug: string; icon: string } {
  const s = slug.toLowerCase();
  const t = title.toLowerCase();

  // 1. AI Agents
  if (
    s === "read-otp-verification-code-in-ai-agent" ||
    s === "build-ai-agent-that-sends-and-receives-email" ||
    s === "email-for-ai-agents" ||
    s === "agent-email-identity" ||
    s === "form-backend-for-ai-agents" ||
    s === "can-ai-agents-submit-forms-safely" ||
    s === "how-to-build-ai-ready-forms-for-autonomous-agents" ||
    s === "what-is-an-agent-email-api" ||
    s.includes("ai-agent") ||
    s.includes("agent")
  ) {
    return { category: "AI Agents", categorySlug: "ai-agents", icon: "🤖" };
  }

  // 2. Email Testing
  if (
    s === "how-to-automate-otp-email-testing-in-ci-cd-pipelines" ||
    s === "test-inbox-docker" ||
    s === "assert-on-email-in-playwright-cypress" ||
    s === "email-testing-api-for-ci" ||
    s === "test-otp-email-in-ci" ||
    s.includes("test-otp") ||
    s.includes("email-ci-benchmarks") ||
    (s.includes("test") && (s.includes("email") || s.includes("inbox") || s.includes("otp")))
  ) {
    return { category: "Email Testing", categorySlug: "email-testing", icon: "✉️" };
  }

  // 3. Comparisons
  if (
    s === "agentmail-alternative" ||
    s === "mailosaur-alternative" ||
    s === "formspree-alternative" ||
    s === "resend-free-tier-alternative" ||
    s === "sendgrid-free-alternative" ||
    s === "formspree-vs-netlify-forms" ||
    s === "basin-vs-web3forms" ||
    s === "forminit-alternatives" ||
    s === "mailosaur-vs-mailinator-vs-disposable-inboxes" ||
    s === "self-host-vs-hosted-form-backend" ||
    s.includes("-vs-") ||
    (s.includes("alternative") && !s.includes("migrate"))
  ) {
    return { category: "Comparisons", categorySlug: "comparisons", icon: "⚖️" };
  }

  // 4. Migrations
  if (
    s === "migrate-from-getform" ||
    s === "migrate-from-basin" ||
    s === "migrate-from-netlify-forms" ||
    s === "migrate-from-formspree" ||
    s === "netlify-forms-alternatives" ||
    s === "formspree-migration-pitfalls" ||
    s === "formspree-webhook-migration-node" ||
    s.includes("migrate") ||
    s.includes("migration")
  ) {
    return { category: "Migrations", categorySlug: "migrations", icon: "🚀" };
  }

  // 5. Integrations
  if (
    s === "form-webhooks-guide" ||
    s === "remix-form-quickstart" ||
    s === "vue-nuxt-form-quickstart" ||
    s === "react-hook-form-backend" ||
    s === "sveltekit-form-quickstart" ||
    s === "astro-form-quickstart" ||
    s === "nextjs-quickstart-hosted-form" ||
    s === "how-to-connect-a-contact-form-to-email-without-backend-code" ||
    s === "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" ||
    s.includes("quickstart") ||
    s.includes("hook-form") ||
    s.includes("webhooks") ||
    s.includes("nextjs-serverless") ||
    s.includes("resend-integration") ||
    s.includes("dodopayments")
  ) {
    return { category: "Integrations", categorySlug: "integrations", icon: "🔌" };
  }

  // 6. Deliverability
  if (
    s === "per-tenant-smtp-guide" ||
    s === "dkim-spf-dmarc-custom-sender" ||
    s.includes("deliverability") ||
    s.includes("smtp") ||
    s.includes("dkim") ||
    s.includes("bounce") ||
    s.includes("custom-sender")
  ) {
    return { category: "Deliverability", categorySlug: "deliverability", icon: "📬" };
  }

  // 7. Security
  if (
    s === "secure-forms-honeypot-captcha" ||
    s === "ml-quarantine-explained" ||
    s.includes("security") ||
    s.includes("quarantine") ||
    s.includes("honeypot") ||
    s.includes("captcha")
  ) {
    return { category: "Security", categorySlug: "security", icon: "🛡️" };
  }

  // 8. Forms / General
  return { category: "Forms", categorySlug: "forms", icon: "⚡" };
}

// 1. Fetch content collection posts
const rawContentPosts = await getCollection("blog");

const contentPosts = rawContentPosts.map((entry) => {
  const meta = getPostCategory(entry.slug, entry.data.title);
  return {
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    date: entry.data.pubDate ? entry.data.pubDate.toISOString().slice(0, 10) : "2026-08-01",
    readingTime: entry.data.readingTime || "8 min read",
    category: meta.category,
    categorySlug: meta.categorySlug,
    icon: meta.icon,
  };
});

// 2. Fetch legacy posts
const mappedLegacyPosts = (legacyPosts || []).map((p: any) => {
  const meta = getPostCategory(p.slug, p.title);
  return {
    slug: p.slug,
    title: p.title,
    description: p.description,
    date: p.date,
    readingTime: p.readingTime || "7 min read",
    category: meta.category,
    categorySlug: meta.categorySlug,
    icon: meta.icon,
  };
});

// Merge and deduplicate by slug
const allPostsMap = new Map<string, any>();
for (const p of [...contentPosts, ...mappedLegacyPosts]) {
  if (!allPostsMap.has(p.slug)) {
    allPostsMap.set(p.slug, p);
  }
}

const posts = Array.from(allPostsMap.values()).sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

// Curated lists for sidebars matching the reference picture
const essentialGuides = [
  { title: "What Is a Headless Form? A Simple Guide to Modern Developers", slug: "what-is-a-headless-form-a-simple-guide-to-modern-developers" },
  { title: "How to Build AI-Ready Forms for Autonomous Agents", slug: "how-to-build-ai-ready-forms-for-autonomous-agents" },
  { title: "Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing in 2026", slug: "mailosaur-vs-mailinator-vs-disposable-inboxes" },
  { title: "Self-Host vs Hosted Form Backend: Complete 2026 Decision Framework", slug: "self-host-vs-hosted-form-backend" },
  { title: "How to Connect a Contact Form to Email Without Backend Code (2026 Guide)", slug: "how-to-connect-a-contact-form-to-email-without-backend-code" },
  { title: "What Is an Agent Email API and Why Does It Matter for AI Workflows?", slug: "what-is-an-agent-email-api" },
  { title: "How to Automate OTP Email Testing in CI/CD Pipelines", slug: "how-to-automate-otp-email-testing-in-ci-cd-pipelines" },
  { title: "Welcome to the OllaStack blog", slug: "welcome-to-the-blog" },
  { title: "Getting started with OllaStack", slug: "getting-started" },
  { title: "How to Build a Form Backend for a Static Site Without Writing a Server", slug: "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server" },
  { title: "Form design for higher conversions (and less spam)", slug: "form-design-conversion" },
  { title: "Test email in Docker and CI with a disposable inbox", slug: "test-inbox-docker" },
  { title: "Assert on email in Playwright and Cypress", slug: "assert-on-email-in-playwright-cypress" },
  { title: "Email testing API: assert on real emails in CI", slug: "email-testing-api-for-ci" },
  { title: "Per-tenant SMTP: send from each customer's own server", slug: "per-tenant-smtp-guide" },
];

const agentWorkflows = [
  { title: "How to Build AI-Ready Forms for Autonomous Agents", slug: "how-to-build-ai-ready-forms-for-autonomous-agents" },
  { title: "Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing in 2026", slug: "mailosaur-vs-mailinator-vs-disposable-inboxes" },
  { title: "How to Connect a Contact Form to Email Without Backend Code (2026 Guide)", slug: "how-to-connect-a-contact-form-to-email-without-backend-code" },
  { title: "What Is an Agent Email API and Why Does It Matter for AI Workflows?", slug: "what-is-an-agent-email-api" },
  { title: "Form Backend vs Form Builder: What Developers Should Choose in 2026", slug: "form-backend-vs-form-builder" },
  { title: "How to Automate OTP Email Testing in CI/CD Pipelines", slug: "how-to-automate-otp-email-testing-in-ci-cd-pipelines" },
  { title: "Test email in Docker and CI with a disposable inbox", slug: "test-inbox-docker" },
  { title: "Can AI Agents Submit Forms Safely? Here's What Developers Need to Know", slug: "can-ai-agents-submit-forms-safely" },
  { title: "Assert on email in Playwright and Cypress", slug: "assert-on-email-in-playwright-cypress" },
  { title: "Email testing API: assert on real emails in CI", slug: "email-testing-api-for-ci" },
  { title: "How to read an OTP / verification code in an AI agent", slug: "read-otp-verification-code-in-ai-agent" },
  { title: "Build an AI agent that sends and receives email (with MCP)", slug: "build-ai-agent-that-sends-and-receives-email" },
  { title: "Email for AI agents: give an agent its own inbox", slug: "email-for-ai-agents" },
  { title: "ML spam quarantine, and why a form backend should fail open", slug: "ml-quarantine-explained" },
  { title: "AgentMail alternative: agent email + forms + testing", slug: "agentmail-alternative" },
];

const categories = [
  { name: "All", slug: "all" },
  { name: "Forms", slug: "forms" },
  { name: "AI Agents", slug: "ai-agents" },
  { name: "Email Testing", slug: "email-testing" },
  { name: "Integrations", slug: "integrations" },
  { name: "Comparisons", slug: "comparisons" },
  { name: "Deliverability", slug: "deliverability" },
];
---

<Base
  title="Engineering Blog & Developer Playbooks — Ollastack"
  description="Technical deep-dives, architectural guides, and developer playbooks on AI agent forms, disposable test inboxes, programmatic email APIs, and webhook reliability."
  current="blog"
>
  <!-- TOP RED SOCIAL PROOF BANNER -->
  <div class="red-social-bar">
    <div class="red-bar-inner">
      <div class="social-item"><span>👤 Developer-First Infrastructure</span></div>
      <span class="social-dot">•</span>
      <div class="social-item"><span class="star-gold">4.9★</span> <span>Developer Rating (1,173)</span></div>
      <span class="social-dot">•</span>
      <div class="social-item"><span class="star-gold">99.99%</span> <span>Global SLA Uptime</span></div>
      <span class="social-dot">•</span>
      <div class="social-item"><span>🤖 MCP Agent Compatible</span></div>
      <span class="social-dot">•</span>
      <div class="social-item"><span>10M+ Form Submissions</span></div>
      <span class="social-dot">•</span>
      <div class="social-item"><span>SOC2 Type II Certified</span></div>
      <span class="social-dot">•</span>
      <div class="social-item"><span>Playwright &amp; Cypress CI</span></div>
    </div>
  </div>

  <!-- MAIN 3-COLUMN MAGAZINE SECTION (EXACT REFERENCE LAYOUT) -->
  <main class="blog-main-wrapper">
    <div class="magazine-grid">
      
      <!-- ================= LEFT COLUMN: ESSENTIAL GUIDES ================= -->
      <aside class="col-sidebar sidebar-left" aria-label="Essential Guides">
        <div class="sidebar-badge-wrap">
          <div class="pill-badge pill-orange">
            <span>⚡ ESSENTIAL GUIDES</span>
          </div>
        </div>

        <ul class="sidebar-link-list">
          {essentialGuides.map((guide) => (
            <li class="sidebar-link-item">
              <a href={`/blog/${guide.slug}`} class="side-link">{guide.title}</a>
            </li>
          ))}
        </ul>

        <div class="sidebar-footer-link">
          <a href="#all-articles-section" class="view-all-link">View All →</a>
        </div>
      </aside>

      <!-- ================= CENTER COLUMN: MAIN FEED ================= -->
      <section class="col-center-main" aria-label="Main Feed">
        
        <!-- Main Heading -->
        <div class="center-heading-box">
          <h1 class="center-main-title">Notes from building the message layer for AI agents .</h1>
          <p class="center-sub-title">
            Practical pieces on shipping forms, automated email verification in CI, and handling traffic an AI agent actually wants to talk to.
          </p>
        </div>

        <!-- Newest Articles Pill Bar -->
        <div class="newest-tab-bar">
          <span class="pill-newest-badge">
            <span>🔥</span>
            <span>NEWEST ARTICLES</span>
          </span>
          <span class="newest-subtext">Latest from our engineering team</span>
        </div>

        <!-- 1. HERO FEATURED ARTICLE (GOLDEN / AMBER BORDER) -->
        <a href="/blog/what-is-a-headless-form-a-simple-guide-to-modern-developers" class="hero-featured-card" aria-label="Read What Is a Headless Form?">
          <div class="hero-card-grid">
            <div class="hero-image-pane">
              <img
                src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=700&q=80"
                alt="Code editor and terminal workflow"
                class="hero-thumb-img"
                loading="eager"
              />
            </div>
            <div class="hero-content-pane">
              <div>
                <div class="hero-tags-row">
                  <span class="tag-badge tag-forms">Forms</span>
                  <span class="tag-badge tag-new">✨ NEW</span>
                </div>
                <h2 class="hero-title">What Is a Headless Form? A Simple Guide to Modern Developers</h2>
                <p class="hero-excerpt">
                  A plain English breakdown of headless forms, what they are, how they work, why developers are switching to them, and how they compare to traditional forms and form builders in 2026.
                </p>
              </div>
              <div class="hero-meta-row">
                <span>23 min read</span>
                <span>•</span>
                <span class="read-more">Read article →</span>
              </div>
            </div>
          </div>
        </a>

        <!-- 2. THREE-CARDS ROW (GOLDEN / AMBER BORDERS) -->
        <div class="three-cards-row">
          
          <!-- Card 1: AI Agents -->
          <a href="/blog/how-to-build-ai-ready-forms-for-autonomous-agents" class="card-amber-outline">
            <div class="card-top-content">
              <span class="card-category-badge">AI Agents</span>
              <h3 class="card-title-3row">How to Build AI-Ready Forms for Autonomous Agents</h3>
              <p class="card-excerpt-3row">
                A practical, developer-focused guide on designing forms that AI agents can fill, validate, and submit reliably, covering schema design, authentication, error handling, and testing.
              </p>
            </div>
            <div class="card-bottom-meta">
              <span>22 min read</span>
            </div>
          </a>

          <!-- Card 2: Comparisons -->
          <a href="/blog/mailosaur-vs-mailinator-vs-disposable-inboxes" class="card-amber-outline">
            <div class="card-top-content">
              <span class="card-category-badge">Comparisons</span>
              <h3 class="card-title-3row">Mailosaur vs Mailinator vs Disposable Inboxes: Which Is Best for QA Testing in 2026</h3>
              <p class="card-excerpt-3row">
                A real-world comparison of Mailosaur, Mailinator and disposable inbox tools for QA testing. Learn which one fits OTP testing, CI pipelines, Playwright, Cypress and automated email verification.
              </p>
            </div>
            <div class="card-bottom-meta">
              <span>22 min read</span>
            </div>
          </a>

          <!-- Card 3: Comparisons -->
          <a href="/blog/self-host-vs-hosted-form-backend" class="card-amber-outline">
            <div class="card-top-content">
              <span class="card-category-badge">Comparisons</span>
              <h3 class="card-title-3row">Self-Host vs Hosted Form Backend: Complete 2026 Decision Framework</h3>
              <p class="card-excerpt-3row">
                Should you build and self-host your own form backend or choose a hosted service? A complete 2026 engineering decision framework covering TCO, deliverability, spam quarantining, AI agent access, compliance, and zero-lock-in architectures.
              </p>
            </div>
            <div class="card-bottom-meta">
              <span>22 min read</span>
            </div>
          </a>

        </div>

        <!-- 3. ALL PUBLICATIONS SECTION WITH PAGE-WISE PAGINATION -->
        <section class="all-publications-container" id="all-articles-section" aria-label="All Publications Archive">
          <div class="feed-header-wrap">
            <div class="feed-title-box">
              <div class="pill-badge pill-section-highlight">
                <span>📚 COMPLETE LIBRARY</span>
              </div>
              <h2 class="feed-title">
                <span>All Publications</span>
                <span class="feed-count-number">({posts.length})</span>
              </h2>
            </div>

            <div class="search-input-wrap">
              <svg class="search-icon-svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input type="text" id="blog-search-input" class="search-input" placeholder="Search all guides & playbooks..." aria-label="Search articles" />
            </div>
          </div>

          <!-- Category Filter Tabs -->
          <div class="category-filter-bar">
            {categories.map((cat, idx) => (
              <button
                type="button"
                class={`cat-filter-btn ${idx === 0 ? "active" : ""}`}
                data-category={cat.name}
              >
                {cat.name}
              </button>
            ))}
          </div>

          <!-- Publications Grid (Populated dynamically & page-wise) -->
          <div class="publications-grid" id="publications-grid">
            {posts.map((post) => (
              <article
                class="pub-card post-item-card"
                data-category={post.category}
                data-title={post.title.toLowerCase()}
                data-desc={post.description.toLowerCase()}
              >
                <a href={`/blog/${post.slug}`} class="pub-card-link">
                  <div class="pub-card-meta">
                    <span class={`pub-pill pill-cat-${post.categorySlug}`}>{post.category}</span>
                    <span class="pub-time mono">⏱ {post.readingTime}</span>
                  </div>
                  <h4 class="pub-title">{post.title}</h4>
                  <p class="pub-desc">{post.description}</p>
                  <div class="pub-card-foot">
                    <span class="pub-read-action">Read guide <span class="action-arrow">→</span></span>
                  </div>
                </a>
              </article>
            ))}
          </div>

          <!-- Page Wise Pagination Controls -->
          <div class="pagination-wrapper" id="pagination-wrapper">
            <div class="pagination-controls" id="pagination-controls">
              <!-- Dynamic JS injected page buttons -->
            </div>
            <span class="pagination-info" id="pagination-info">
              Showing 1–6 of {posts.length} articles
            </span>
          </div>
        </section>

      <!-- ================= RIGHT COLUMN: AGENT WORKFLOWS ================= -->
      <aside class="col-sidebar sidebar-right" aria-label="Agent Workflows">
        <div class="sidebar-badge-wrap">
          <div class="pill-badge pill-purple">
            <span>🤖 AGENT WORKFLOWS</span>
          </div>
        </div>

        <ul class="sidebar-link-list">
          {agentWorkflows.map((guide) => (
            <li class="sidebar-link-item">
              <a href={`/blog/${guide.slug}`} class="side-link">{guide.title}</a>
            </li>
          ))}
        </ul>

        <div class="sidebar-footer-link">
          <a href="#all-articles-section" class="view-all-link view-all-purple">View All →</a>
        </div>
      </aside>

    </div>
  </main>

  <!-- FLOATING RED CTA BUTTON -->
  <a href="https://login.ollastack.com/register" target="_blank" class="floating-cta-btn" id="floating-cta-button">
    <span>✦</span>
    <span>Start Building Free</span>
  </a>
</Base>

<style>
  /* ==========================================================================
     EXACT 3-COLUMN MAGAZINE LAYOUT & GOLDEN AMBER BORDER CARDS
     ========================================================================== */
  
  /* Top Red Social Proof Banner */
  .red-social-bar {
    background: #da291c;
    color: #ffffff;
    padding: 8px 0;
    width: 100%;
    overflow: hidden;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .red-bar-inner {
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .social-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .social-dot {
    color: rgba(255, 255, 255, 0.6);
    font-size: 8px;
  }

  .star-gold {
    color: #fbbf24;
  }

  /* Main Wrapper */
  .blog-main-wrapper {
    max-width: 100%;
    margin: 0;
    padding: 28px 16px 80px;
    width: 100%;
    background: #ffffff;
  }

  .magazine-grid {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr) 280px;
    gap: 24px;
    align-items: start;
    width: 100%;
  }

  /* Sidebars (Left & Right) */
  .col-sidebar {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 24px 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    position: sticky;
    top: 90px;
  }

  .sidebar-badge-wrap {
    margin-bottom: 20px;
  }

  .pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 16px;
    border-radius: 9999px;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    user-select: none;
  }

  .pill-orange {
    background: linear-gradient(135deg, #ea580c 0%, #f97316 100%);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(234, 88, 12, 0.25);
  }

  .pill-purple {
    background: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 100%);
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(124, 58, 237, 0.25);
  }

  .sidebar-link-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .side-link {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.45;
    color: #334155;
    display: block;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .sidebar-left .sidebar-link-item:first-child .side-link {
    color: #c2410c;
    font-weight: 700;
  }

  .sidebar-right .sidebar-link-item:first-child .side-link {
    color: #7c3aed;
    font-weight: 700;
  }

  .side-link:hover {
    color: #ea580c;
    transform: translateX(2px);
  }

  .sidebar-right .side-link:hover {
    color: #7c3aed;
  }

  .sidebar-footer-link {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px dashed #e2e8f0;
  }

  .view-all-link {
    font-size: 12.5px;
    font-weight: 700;
    color: #ea580c;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .view-all-link:hover {
    gap: 7px;
