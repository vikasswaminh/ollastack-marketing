---
// Renders every markdown post in the `blog` content collection through the
// shared BlogPost layout. Named .astro post pages in this directory take
// precedence over this catch-all, so the two systems coexist.
import { getCollection } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
  const staticSlugs = new Set([
    "basin-vs-web3forms",
    "can-ai-agents-submit-forms-safely",
    "form-backend-for-ai-agents",
    "forminit-alternatives",
    "formspree-vs-netlify-forms",
    "html-form-to-email-without-backend",
    "netlify-forms-alternatives",
    "how-to-build-a-form-backend-for-a-static-site",
    "how-to-build-a-form-backend-for-a-static-site-without-writing-a-server",
  ]);
  const posts = await getCollection(
    "blog",
    ({ data, slug }) => data.draft !== true && !staticSlugs.has(slug)
  );
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const iso = (date: Date) => date.toISOString().slice(0, 10);
---

<BlogPost
  slug={post.slug}
  title={d.title}
  description={d.description}
  publishedAt={iso(d.date)}
  updatedAt={iso(d.updated ?? d.date)}
  readingTime={`${d.readingTime} min read`}
  ctaLocation="blog"
  faq={d.faq}
  wrappingUp={d.wrappingUp}
  relatedReading={d.relatedReading}
>
  <p class="lede">{d.description}</p>
  <Content />
</BlogPost>
