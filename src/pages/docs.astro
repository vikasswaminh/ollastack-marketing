const sections = [
  { id: "apis", title: "All APIs by purpose" },
  { id: "quickstart", title: "Quickstart" },
  { id: "html", title: "HTML form" },
  { id: "react", title: "React" },
  { id: "fetch", title: "fetch / curl" },
  { id: "hosted", title: "Hosted form page" },
  { id: "magic-fields", title: "Magic fields" },
  { id: "recipients", title: "Notification recipients" },
  { id: "captcha", title: "CAPTCHA" },
  { id: "origins", title: "Allowed origins" },
  { id: "validation", title: "Schema validation" },
  { id: "multistep", title: "Multi-step + show-if" },
  { id: "autoresponder", title: "Autoresponder" },
  { id: "webhooks", title: "Webhooks" },
  { id: "integrations", title: "Integrations" },
  { id: "exports", title: "Exports" },
  { id: "analytics", title: "Analytics" },
